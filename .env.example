SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=0
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.100
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Europe/Moscow
DB_ENGINE=postgres

POSTGRES_DB=tasktracker
POSTGRES_USER=tasktracker
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0

# Portable backups are written on the Raspberry Pi host, outside Docker volumes.
# Use an absolute path so the resulting archive is easy to copy to a USB drive.
HOST_BACKUP_DIR=/home/adminka/projects/backups/task-tracker
BACKUP_KEEP=20
