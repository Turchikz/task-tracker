# Task Tracker — example production environment
# Copy this file to .env and replace all change-me/example values.
# Never commit the real .env file.

# Django
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=0

# Hosts without scheme or port.
# Add your Raspberry Pi LAN IP and CrazeDNS hostname.
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.34,task.crazynet.netcraze.link

# Origins must include scheme and port where applicable.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://192.168.1.34:8081,https://task.crazynet.netcraze.link

TIME_ZONE=Europe/Moscow

# PostgreSQL
DB_ENGINE=postgres
POSTGRES_DB=tasktracker
POSTGRES_USER=tasktracker
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Nginx external port
APP_PORT=8081

# Keep these disabled while the site is also used over plain HTTP in the LAN.
# If later all access is HTTPS-only, they can be enabled.
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0

# Portable backups are written on the Raspberry Pi host, outside Docker volumes.
# Use an absolute path so the resulting archive is easy to copy to a USB drive.
HOST_BACKUP_DIR=/home/adminka/projects/backups/task-tracker
BACKUP_KEEP=20
